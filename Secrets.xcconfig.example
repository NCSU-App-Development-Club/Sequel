//
// How to get a TMDB API key:
//   1. Create an account at https://www.themoviedb.org
//   2. Go to Settings → API → Request an API key (v3 auth)
//   3. Copy the key and paste it below

TMDB_API_KEY = your_tmdb_v3_api_key_here
